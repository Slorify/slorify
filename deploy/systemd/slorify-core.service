[Unit]
Description=Slorify Core API
After=network.target postgresql.service

[Service]
Type=simple
User=slorify
Group=slorify
WorkingDirectory=/opt/slorify/app/slora-core
Environment=NODE_ENV=production
Environment=PORT=4000
EnvironmentFile=-/opt/slorify/app/slora-core/.env
ExecStart=/usr/bin/node dist/src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
